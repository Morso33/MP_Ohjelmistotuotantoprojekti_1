<?xml version="1.0" encoding="UTF-8"?>

<!-- The window of the Temperature Converter. Every "%key" is read from the resource bundle
     (MessagesBundle_<locale>.properties) that Main.loadView passes to the FXMLLoader. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.MainController" spacing="12">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="%app.title" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%label.language"/>
        <ComboBox fx:id="languageBox"/>
    </HBox>

    <GridPane hgap="8" vgap="8">
        <Label text="%label.temperature" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="valueField" promptText="%prompt.value" prefColumnCount="10"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%label.from" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="fromBox" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%label.to" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="toBox" prefWidth="200" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Button fx:id="swapButton" text="%button.swap" onAction="#swapUnits"
                GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.rowSpan="2"/>
    </GridPane>

    <Button fx:id="convertButton" text="%button.convert" defaultButton="true" onAction="#convert"/>

    <Label fx:id="resultLabel" text="%result.initial" style="-fx-font-size: 20px;"/>
    <Label fx:id="messageLabel"/>

    <Label text="%history.title" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="%history.empty"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="timeColumn" text="%column.time"/>
            <TableColumn fx:id="fromColumn" text="%column.from"/>
            <TableColumn fx:id="toColumn" text="%column.to"/>
            <TableColumn fx:id="languageColumn" text="%column.language"/>
        </columns>
    </TableView>

    <Button fx:id="clearButton" text="%button.clear" onAction="#clearHistory"/>
    <Label fx:id="databaseLabel" style="-fx-text-fill: gray;"/>
</VBox>
